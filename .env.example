# Copy to .env and fill in. Everything is optional; a plugin that needs a missing key just reports an error.

# Where the fine-tuned model is kept between Colab sessions (a private repo is created on first push).
# Token needs write access: https://huggingface.co/settings/tokens
HF_REPO=your-username/saturday
HF_TOKEN=

# https://openweathermap.org/api (free tier)
OPENWEATHER_API_KEY=

# Account used by send_email. For Gmail create an App Password: https://myaccount.google.com/apppasswords
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
